 "doctype": "Print Format",
 "font_size": 14,
 "html": "<div style=\"font-family: Arial, sans-serif; font-size: 13px; color: #000;\">\r\n\r\n  <!-- Header with Logo and Company Name -->\r\n  <div style=\"text-align: center; margin-bottom: 10px;\">\r\n    {% set logo = frappe.db.get_value('Company', doc.company, 'company_logo') %}\r\n    {% if logo %}\r\n      <img src=\"{{ logo }}\" alt=\"Company Logo\" height=\"60\"><br>\r\n    {% endif %}\r\n    <h2 style=\"margin: 5px 0; color: #004aad;\">{{ doc.company }}</h2>\r\n    <h4 style=\"margin: 0; color: #333;\">Salary Slip</h4>\r\n    <small style=\"color: gray;\">For the period: {{ frappe.format_date(doc.start_date, \"dd MMM yyyy\") }} - {{ frappe.format_date(doc.end_date, \"dd MMM yyyy\") }}</small>\r\n  </div>\r\n\r\n  <hr style=\"margin: 10px 0; border-top: 2px solid #004aad;\">\r\n\r\n  <!-- Employee Info -->\r\n  <table width=\"100%\" cellspacing=\"0\" cellpadding=\"3\">\r\n    <tr>\r\n      <td><b>Employee:</b> {{ doc.employee }}</td>\r\n      <td><b>Start Date:</b> {{ frappe.format_date(doc.start_date) }}</td>\r\n    </tr>\r\n    <tr>\r\n      <td><b>Employee Name:</b> {{ doc.employee_name }}</td>\r\n      <td><b>End Date:</b> {{ frappe.format_date(doc.end_date) }}</td>\r\n    </tr>\r\n    <tr>\r\n      <td><b>Designation:</b> {{ doc.designation or '' }}</td>\r\n      <td><b>Working Days:</b> {{ doc.total_working_days }}</td>\r\n    </tr>\r\n    <tr>\r\n      <td><b>Department:</b> {{ doc.department or '' }}</td>\r\n      <td><b>Leave Without Pay:</b> {{ doc.leave_without_pay or 0 }}</td>\r\n    </tr>\r\n    <tr>\r\n      <td></td>\r\n      <td><b>Payment Days:</b> {{ doc.payment_days or 0 }}</td>\r\n    </tr>\r\n  </table>\r\n\r\n  <br>\r\n\r\n  <!-- Earnings and Deductions -->\r\n  <table width=\"100%\" cellspacing=\"0\" cellpadding=\"6\" border=\"1\" style=\"border-collapse: collapse;\">\r\n    <thead style=\"background: #f5f5f5;\">\r\n      <tr>\r\n        <th width=\"50%\">Earnings</th>\r\n        <th width=\"50%\">Deductions</th>\r\n      </tr>\r\n    </thead>\r\n    <tbody>\r\n      <tr>\r\n        <td valign=\"top\">\r\n          <table width=\"100%\" cellspacing=\"0\" cellpadding=\"4\">\r\n            <tr>\r\n              <th>Sr</th><th>Component</th><th style=\"text-align:right;\">Amount</th>\r\n            </tr>\r\n            {% for e in doc.earnings %}\r\n            <tr>\r\n              <td>{{ loop.index }}</td>\r\n              <td>{{ e.salary_component }}</td>\r\n              <td style=\"text-align:right;\">{{ e.amount or 0 }} {{ doc.currency }}</td>\r\n            </tr>\r\n            {% endfor %}\r\n          </table>\r\n        </td>\r\n        <td valign=\"top\">\r\n          <table width=\"100%\" cellspacing=\"0\" cellpadding=\"4\">\r\n            <tr>\r\n              <th>Sr</th><th>Component</th><th style=\"text-align:right;\">Amount</th>\r\n            </tr>\r\n            {% for d in doc.deductions %}\r\n            <tr>\r\n              <td>{{ loop.index }}</td>\r\n              <td>{{ d.salary_component }}</td>\r\n              <td style=\"text-align:right;\">{{ d.amount or 0 }} {{ doc.currency }}</td>\r\n            </tr>\r\n            {% endfor %}\r\n          </table>\r\n        </td>\r\n      </tr>\r\n    </tbody>\r\n  </table>\r\n\r\n  <br>\r\n\r\n  <!-- Totals Section -->\r\n  <table width=\"100%\" cellspacing=\"0\" cellpadding=\"4\">\r\n    <tr>\r\n      <td width=\"70%\">\r\n        <b>Gross Pay:</b> {{ doc.gross_pay }} {{ doc.currency }}<br>\r\n        <b>Total Deduction:</b> {{ doc.total_deduction }} {{ doc.currency }}<br>\r\n        <b>Net Pay:</b> {{ doc.net_pay }} {{ doc.currency }}<br>\r\n        <b>Rounded Total:</b> {{ doc.rounded_total }} {{ doc.currency }}<br>\r\n        <b>Total in Words:</b> {{ doc.total_in_words }}\r\n      </td>\r\n    </tr>\r\n  </table>\r\n\r\n  <br>\r\n\r\n  <div style=\"text-align: right; margin-top: 20px;\">\r\n    <p><b>Authorized Signature</b></p>\r\n  </div>\r\n</div>\r\n",
