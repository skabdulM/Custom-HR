 "font_size": 14,
 "html": "<!DOCTYPE html>\r\n<html>\r\n<head>\r\n    <meta charset=\"utf-8\">\r\n    <title>Employee Exit Report - {{ doc.employee_name }}</title>\r\n    <style>\r\n        body {\r\n            font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;\r\n            margin: 40px;\r\n            color: #2d2d2d;\r\n            line-height: 1.6;\r\n        }\r\n        .header {\r\n            text-align: center;\r\n            border-bottom: 3px solid #1e88e5;\r\n            padding-bottom: 15px;\r\n            margin-bottom: 30px;\r\n        }\r\n        .header h1 {\r\n            margin: 0;\r\n            color: #1e88e5;\r\n            font-size: 26px;\r\n        }\r\n        .header p {\r\n            margin: 5px 0;\r\n            font-size: 14px;\r\n            color: #555;\r\n        }\r\n        .section {\r\n            margin-bottom: 30px;\r\n            page-break-inside: avoid;\r\n        }\r\n        .section h2 {\r\n            background: #f5f5f5;\r\n            padding: 10px 15px;\r\n            border-left: 5px solid #1e88e5;\r\n            font-size: 18px;\r\n            margin: 0 0 15px 0;\r\n            color: #1e88e5;\r\n        }\r\n        table {\r\n            width: 100%;\r\n            border-collapse: collapse;\r\n            margin-bottom: 20px;\r\n        }\r\n        th, td {\r\n            padding: 10px 12px;\r\n            border: 1px solid #ddd;\r\n            text-align: left;\r\n            vertical-align: top;\r\n        }\r\n        th {\r\n            background-color: #f0f7ff;\r\n            font-weight: 600;\r\n            color: #1e88e5;\r\n            width: 35%;\r\n        }\r\n        .feedback-box {\r\n            background: #f9f9f9;\r\n            padding: 15px;\r\n            border-left: 4px solid #4caf50;\r\n            margin: 15px 0;\r\n            border-radius: 4px;\r\n        }\r\n        .tag {\r\n            display: inline-block;\r\n            background: #e3f2fd;\r\n            color: #1565c0;\r\n            padding: 4px 10px;\r\n            border-radius: 12px;\r\n            font-size: 12px;\r\n            margin-right: 6px;\r\n            margin-bottom: 6px;\r\n        }\r\n        .footer {\r\n            margin-top: 50px;\r\n            border-top: 1px solid #ccc;\r\n            padding-top: 20px;\r\n            font-size: 12px;\r\n            color: #777;\r\n            text-align: center;\r\n        }\r\n        .signature {\r\n            margin-top: 40px;\r\n            display: flex;\r\n            justify-content: space-between;\r\n        }\r\n        .signature div {\r\n            width: 45%;\r\n            border-top: 1px solid #aaa;\r\n            padding-top: 10px;\r\n            text-align: center;\r\n            font-size: 13px;\r\n        }\r\n        @media print {\r\n            body { margin: 20px; }\r\n            .no-print { display: none; }\r\n        }\r\n    </style>\r\n</head>\r\n<body>\r\n\r\n<div class=\"header\">\r\n    <h1>Employee Exit Report</h1>\r\n    <p><strong>Employee ID:</strong> {{ doc.name }} | <strong>Generated On:</strong> {{ frappe.utils.format_date(frappe.utils.nowdate(), \"dd-MM-yyyy\") }}</p>\r\n</div>\r\n\r\n<!-- Employee Info -->\r\n<div class=\"section\">\r\n    <h2>Employee Details</h2>\r\n    <table>\r\n        <tr><th>Full Name</th><td>{{ doc.employee_name or \"N/A\" }}</td></tr>\r\n        <tr><th>Employee ID</th><td>{{ doc.name }}</td></tr>\r\n        <tr><th>Department</th><td>{{ doc.department or \"Not Set\" }}</td></tr>\r\n        <tr><th>Designation</th><td>{{ doc.designation or \"Not Set\" }}</td></tr>\r\n        <tr><th>Joining Date</th><td>{{ frappe.utils.format_date(doc.date_of_joining) if doc.date_of_joining else \"N/A\" }}</td></tr>\r\n        <tr><th>Last Working Day</th><td>{{ frappe.utils.format_date(doc.relieving_date) }}</td></tr>\r\n    </table>\r\n</div>\r\n\r\n<!-- Exit Timeline -->\r\n<div class=\"section\">\r\n    <h2>Exit Process Timeline</h2>\r\n    <table>\r\n        <tr><th>Resignation Letter Date</th><td>{{ frappe.utils.format_date(doc.resignation_letter_date) }}</td></tr>\r\n        <tr><th>Relieving Date</th><td>{{ frappe.utils.format_date(doc.relieving_date) }}</td></tr>\r\n        <tr><th>Exit Interview Held On</th><td>{{ frappe.utils.format_date(doc.exit_interview_date) or \"Not Conducted\" }}</td></tr>\r\n        <tr><th>Leave Encashed?</th><td>{{ \"Yes\" if doc.leave_encashed else \"No\" }}</td></tr>\r\n        {% if doc.encashment_date %}\r\n        <tr><th>Encashment Date</th><td>{{ frappe.utils.format_date(doc.encashment_date) }}</td></tr>\r\n        {% endif %}\r\n        <tr><th>New Workplace</th><td>{{ doc.new_workplace or \"Not Disclosed\" }}</td></tr>\r\n    </table>\r\n</div>\r\n\r\n<!-- Feedback -->\r\n<div class=\"section\">\r\n    <h2>Exit Feedback</h2>\r\n    {% if doc.reason_for_leaving %}\r\n    <div class=\"feedback-box\">\r\n        <strong>Reason for Leaving:</strong><br>\r\n        {{ doc.reason_for_leaving | replace(\"\\n\", \"<br>\") | safe }}\r\n    </div>\r\n    {% endif %}\r\n\r\n    {% if doc.feedback %}\r\n    <div class=\"feedback-box\">\r\n        <strong>Feedback Provided:</strong><br>\r\n        {{ doc.feedback | replace(\"\\n\", \"<br>\") | safe }}\r\n    </div>\r\n    {% endif %}\r\n</div>\r\n\r\n<!-- Tags -->\r\n{% if doc.get(\"tags\") %}\r\n<div class=\"section\">\r\n    <h2>Tags</h2>\r\n    {% for tag in doc.get(\"tags\") %}\r\n        <span class=\"tag\">{{ tag.tag }}</span>\r\n    {% endfor %}\r\n</div>\r\n{% endif %}\r\n\r\n<!-- Attachments -->\r\n{% if doc.attachments %}\r\n<div class=\"section\">\r\n    <h2>Attachments</h2>\r\n    <ul>\r\n    {% for attachment in doc.attachments %}\r\n        <li><a href=\"{{ attachment.file_url }}\" target=\"_blank\">{{ attachment.file_name }}</a></li>\r\n    {% endfor %}\r\n    </ul>\r\n</div>\r\n{% endif %}\r\n\r\n<!-- Activity Log (Optional) -->\r\n<div class=\"section no-print\">\r\n    <h2>Recent Activity</h2>\r\n    <small>\r\n    {% for log in frappe.get_list(\"Version\", filters={\"ref_doctype\": \"Employee Exit\", \"docname\": doc.name}, fields=[\"creation\", \"owner\", \"data\"], order_by=\"creation desc\", limit=5) %}\r\n        \u2022 {{ frappe.utils.pretty_date(log.creation) }} - {{ log.owner }}: {{ frappe.utils.json.loads(log.data).get(\"changed\", [[]])[0][1] if log.data else \"Updated\" }}<br>\r\n    {% endfor %}\r\n    </small>\r\n</div>\r\n\r\n<!-- Signatures -->\r\n<div class=\"signature\">\r\n    <div>\r\n        <strong>Prepared By (HR)</strong><br>\r\n        ___________________________<br>\r\n        Name: ____________________<br>\r\n        Date: ____________________\r\n    </div>\r\n    <div>\r\n        <strong>Approved By (Manager)</strong><br>\r\n        ___________________________<br>\r\n        Name: ____________________<br>\r\n        Date: ____________________\r\n    </div>\r\n</div>\r\n\r\n<div class=\"footer\">\r\n    <p><em>Confidential Document \u2022 For Internal HR Use Only \u2022 {{ frappe.utils.now() }}</em></p>\r\n</div>\r\n\r\n</body>\r\n</html>",
